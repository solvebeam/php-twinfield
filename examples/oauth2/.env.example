# Twinfield OAuth2 Credentials
# Copy this file to .env and fill in your actual credentials

# Your Twinfield OAuth2 Client ID
TWINFIELD_CLIENT_ID=your_client_id_here

# Your Twinfield OAuth2 Client Secret
TWINFIELD_CLIENT_SECRET=your_client_secret_here

# Redirect URI (must match what you configured in Twinfield)
TWINFIELD_REDIRECT_URI=http://localhost:8000/callback.php

# Scopes (space-separated)
# Common scopes: openid twf.user twf.organisationUser twf.organisation
TWINFIELD_SCOPES=openid twf.user twf.organisationUser twf.organisation
